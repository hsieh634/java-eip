# Copy to .env and edit. .env is git-ignored - never commit it.
# Read by both `docker compose` and Spring Boot. Use only letters and digits in passwords.
# (Comments are ASCII on purpose: Windows PowerShell 5.1 Get-Content garbles UTF-8 text.)

DB_HOST=localhost
DB_PORT=5432
DB_NAME=renewflow
DB_TEST_NAME=renewflow_test
DB_USER=renewflow
DB_PASSWORD=change-me

# Dev profile only: shared password of the seeded accounts admin / manager / employee.
# Leave empty to skip seeding.
RENEWFLOW_DEV_SEED_PASSWORD=change-me-too

# Dev profile only: password of the local administrator account `developer` (role ADMIN).
# Independent from the shared password above. NO default: if empty, `developer` is not created
# and a warning naming this variable is logged. Use letters and digits only.
RENEWFLOW_DEV_DEVELOPER_PASSWORD=

# Dev profile only: set to true for ONE start to re-hash the seeded accounts' passwords from
# RENEWFLOW_DEV_SEED_PASSWORD (employee ids and attendance data are kept). Set back to false afterwards.
RENEWFLOW_DEV_SEED_RESET=false

# Dev profile only: fictional demo company "STMAX" (6 demo accounts stmax_max, stmax_iris, stmax_leo,
# stmax_mia, stmax_ryan, stmax_zoe). OFF by default. When true AND a password is set, missing demo accounts
# are created once; existing ones are never changed (no password reset, no role/enabled change).
# If a username or employee number is already used by someone else, nothing is created.
RENEWFLOW_DEMO_STMAX_ENABLED=false
# Shared password of the 6 demo accounts. NO default: if empty, no demo account is created.
# Use letters and digits only. Put the real value only in your local .env (never commit it).
RENEWFLOW_DEMO_STMAX_PASSWORD=
# Dev profile only: arrange the 6 STMAX accounts into 3 demo departments (MANAGEMENT / PROJECT / ADMINISTRATION)
# and set their direct managers. OFF by default, separate from the switch above. Only fills fields that are still
# unassigned; different existing values are kept and reported. Never changes accounts, passwords, roles or enabled states.
RENEWFLOW_DEMO_STMAX_ORG_ENABLED=false
